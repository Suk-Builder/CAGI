# CAGI 环境变量配置
# 至少配置一个 LLM 后端密钥

DEEPSEEK_API_KEY=your_deepseek_key
GLM_API_KEY=your_glm_key
OPENROUTER_API_KEY=your_openrouter_key
NVIDIA_API_KEY=your_nvidia_key
SILICONFLOW_API_KEY=your_siliconflow_key
MODELSCOPE_API_KEY=your_modelscope_key

# 本地 Ollama（可选）
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3-8b-chat

# 自定义后端（可选）
CUSTOM_API_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=

# 运行参数
CAGI_TEMPERATURE=0.7
CAGI_MAX_CONCURRENT=30
CAGI_POOL_MAX_VIEW=50
CAGI_ROUNDS=3

# API 鉴权（留空则写操作不鉴权，仅本地测试）
CAGI_API_TOKEN=

# 默认后端 fallback 链
CAGI_DEFAULT_BACKEND=nvidia
CAGI_FALLBACK_CHAIN=nvidia,modelscope,openrouter,glm
